# Copy to .env and use your own absolute host paths, outside the code directory.
# Required: obtain the dedicated NAS account numbers with id ACCOUNT.
# Do not use root; make config/key directories owned by this account.
PAWZZ_UID=
PAWZZ_GID=

# app-data is an example existing share; use your own paths.
# Example Synology paths; change volume1 if your storage volume differs.
PAWZZ_CONFIG_DIR=/volume1/app-data/pawzz/config
PAWZZ_SECRETS_DIR=/volume1/app-data/pawzz/certificates
# Keep keys separate from config; do not bundle them in the same backup.
PAWZZ_KEY_DIR=/volume1/app-data/pawzz/keys
PAWZZ_OUTPUT_DIR=/volume1/app-data/pawzz/videos
PAWZZ_WEB_PORT=18080

# Optional HTTPS: put fullchain.pem and privkey.pem in PAWZZ_SECRETS_DIR.
# Paths below are inside the container. Set BOTH to enable HTTPS.
PAWZZ_TLS_CERT=
PAWZZ_TLS_KEY=
